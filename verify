#!/usr/bin/env bash
# verify — dispatcher for the RHCSA/RHCE lab verification scripts.
#
#   ./verify                 list every check available
#   ./verify 1.2             run the Lab 1.2 checks
#   ./verify week1           run every Week 1 check in order
#   ./verify breakfix        the post-repair health check
#   ./verify ex200-a --spec  print a mock's exam paper
#   ./verify bundle          build single-file copies in dist/ for transfer
#   ./verify history         show what has been run on this machine
#
# Anything after the name is passed straight to the lab script, so
# `./verify 2.5 -v --no-mutate` works as expected.
set -uo pipefail

HERE=$(dirname "$(readlink -f "$0")")
LABS=$HERE/labs
LIB=$HERE/lib

if [[ -t 1 ]]; then B=$'\033[1m'; D=$'\033[2m'; G=$'\033[32m'; R=$'\033[31m'; Z=$'\033[0m'
else B=; D=; G=; R=; Z=; fi

# name -> script, in curriculum order
declare -a ORDER=(
  "env:env-check.sh:Lab environment acceptance test (00)"
  "1.1:lab-1.1.sh:Navigation, vim, text processing"
  "1.2:lab-1.2.sh:Users, groups, password policy"
  "1.3:lab-1.3.sh:Permissions, special bits, ACLs"
  "1.4:lab-1.4.sh:sudo and SSH key authentication"
  "1.5:lab-1.5.sh:Find, archives, compression"
  "1.6:lab-1.6.sh:Bash scripting — sysreport"
  "1.7:lab-1.7.sh:Week 1 consolidation (timed)"
  "2.1:lab-2.1.sh:systemd services and targets"
  "2.2:lab-2.2.sh:Processes, journald, scheduled tasks"
  "2.3:lab-2.3.sh:dnf, rpm, repositories"
  "2.4:lab-2.4.sh:Networking with nmcli"
  "2.5:lab-2.5.sh:Partitions, filesystems, swap, fstab"
  "2.6:lab-2.6.sh:LVM"
  "2.7:lab-2.7.sh:NFS, autofs (run on both nodes)"
  "3.1:lab-3.1.sh:SELinux contexts, booleans, ports"
  "3.2:lab-3.2.sh:Reading SELinux denials"
  "3.3:lab-3.3.sh:firewalld zones, ports, rich rules"
  "3.4:lab-3.4.sh:The four boot failures"
  "breakfix:breakfix-health.sh:Post-repair health check (Days 19-21)"
  "advanced:breakfix-advanced.sh:Advanced break-fix drills (Days 22-29)"
  "incident:incident-check.sh:Incident resolution — grade a staged incident"
  "4.1:lab-4.1.sh:Containers with podman (run as the user)"
  "4.2:lab-4.2.sh:tuned, kernel and boot targets"
  "ex200-a:mock-ex200-a.sh:Mock EX200-A grader"
  "ex200-b:mock-ex200-b.sh:Mock EX200-B / C grader"
  "5.1:lab-5.1.sh:Ansible: make the control node work"
  "5.2:lab-5.2.sh:Ansible: a day of admin, ad-hoc"
  "5.3:lab-5.3.sh:Ansible: your first playbook"
  "5.4:lab-5.4.sh:Ansible: variables, facts, precedence"
  "5.5:lab-5.5.sh:Ansible: loops and conditionals"
  "5.6:lab-5.6.sh:Ansible: handlers and error handling"
  "5.7:lab-5.7.sh:Week 5 consolidation (timed)"
  "6.1:lab-6.1.sh:Automate: users, sudo, SSH"
  "6.2:lab-6.2.sh:Automate: packages, repos, services"
  "6.3:lab-6.3.sh:Automate: storage"
  "6.4:lab-6.4.sh:Automate: network, firewall, SELinux"
  "6.5:lab-6.5.sh:Ten servers, zero SSH sessions"
  "7.1:lab-7.1.sh:Templates and Jinja2"
  "7.2:lab-7.2.sh:Decompose into roles"
  "7.3:lab-7.3.sh:Ansible Vault"
  "7.4:lab-7.4.sh:Collections and content"
  "7.5:lab-7.5.sh:Failure handling at scale"
  "s1:scenario-1.sh:Scenario 1 — fleet baseline"
  "s2:scenario-2.sh:Scenario 2 — web tier end to end"
  "s3:scenario-3.sh:Scenario 3 — environment separation"
  "s4:scenario-4.sh:Scenario 4 — secrets"
  "s5:scenario-5.sh:Scenario 5 — a role from nothing"
  "ex294-a:mock-ex294-a.sh:Mock EX294-A / B grader"
)

declare -A LAB_GROUPS=(
  [week1]="1.1 1.2 1.3 1.4 1.5 1.6 1.7"
  [week2]="2.1 2.2 2.3 2.4 2.5 2.6 2.7"
  [week3]="3.1 3.2 3.3 3.4 breakfix"
  [week4]="advanced 4.1 4.2 ex200-a ex200-b"
  [week5]="5.1 5.2 5.3 5.4 5.5 5.6 5.7"
  [week6]="6.1 6.2 6.3 6.4 6.5"
  [week7]="7.1 7.2 7.3 7.4 7.5"
  [week8]="s1 s2 s3 s4 s5"
  [month1]="1.1 1.2 1.3 1.4 1.5 1.6 1.7 2.1 2.2 2.3 2.4 2.5 2.6 2.7 3.1 3.2 3.3 3.4 breakfix advanced 4.1 4.2"
  [month2]="5.1 5.2 5.3 5.4 5.5 5.6 5.7 6.1 6.2 6.3 6.4 6.5 7.1 7.2 7.3 7.4 7.5 s1 s2 s3 s4 s5"
  [mocks]="ex200-a ex200-b ex294-a"
  [health]="breakfix advanced incident"
)

script_for() {
  local want="$1" e
  for e in "${ORDER[@]}"; do
    [[ ${e%%:*} == "$want" ]] && { echo "$LABS/$(cut -d: -f2 <<<"$e")"; return 0; }
  done
  return 1
}

usage() {
  echo "${B}RHCSA/RHCE lab verification${Z}"
  echo
  echo "  ./verify <name> [args]     run one lab's checks"
  echo "  ./verify <group>           run a whole group in order"
  echo "  ./verify bundle            build self-contained copies in dist/"
  echo "  ./verify history           what has been run on this machine"
  echo
  echo "${B}Labs${Z}"
  local e n s d
  for e in "${ORDER[@]}"; do
    n=${e%%:*}; s=$(cut -d: -f2 <<<"$e"); d=$(cut -d: -f3- <<<"$e")
    printf '  %-10s %s%s%s\n' "$n" "$D" "$d" "$Z"
  done
  echo
  echo "${B}Groups${Z}"
  local g
  for g in week1 week2 week3 week4 week5 week6 week7 week8 month1 month2 mocks health; do
    printf '  %-10s %s%s%s\n' "$g" "$D" "${LAB_GROUPS[$g]}" "$Z"
  done
  echo
  echo "${B}Common flags${Z} (passed through to the lab script)"
  echo "  -v            show output for passing checks too"
  echo "  --no-mutate   skip checks that create or delete anything"
  echo "  --after-reboot  refuse to run unless the machine booted recently"
  echo "  --spec        (mocks only) print the exam paper"
  echo "  --only=fN     (advanced) check just one drill"
  echo "  --blind       report pass/fail only, without naming what was checked"
  echo "  --hard        exam conditions: no diagnostics, warnings fail, reboot required"
  echo "  --proj=PATH   (Ansible labs) the project directory, default ~/ansible"
}

# Build single-file scripts, so one scp gets a check onto a node with no network.
do_bundle() {
  local out=$HERE/dist e name src
  mkdir -p "$out"
  for e in "${ORDER[@]}"; do
    name=${e%%:*}; src=$LABS/$(cut -d: -f2 <<<"$e")
    [[ -f $src ]] || continue
    {
      echo '#!/usr/bin/env bash'
      echo "# Self-contained bundle of $(basename "$src") — generated by ./verify bundle"
      cat "$LIB/verify-lib.sh"
      grep -q 'ansible-lib.sh' "$src" && cat "$LIB/ansible-lib.sh"
      grep -vE '^\.[[:space:]]+"(\$_D|\$\(dirname)' "$src"
    } > "$out/$(basename "$src")"
    chmod +x "$out/$(basename "$src")"
  done
  # The saboteur is already standalone; ship it with them.
  [[ -f $HERE/break/break-advanced.sh ]] &&
    install -m 0755 "$HERE/break/break-advanced.sh" "$out/break-advanced.sh"
  echo "${G}Bundled $(ls -1 "$out" | wc -l) self-contained scripts into $out/${Z}"
  echo "Copy what you need to a node:  scp dist/lab-2.5.sh pushpendra@rhel01:"
  echo "Or the whole set:              tar czf verify.tgz dist && scp verify.tgz ..."
}

do_history() {
  local f=/var/tmp/rhce-verify/history.tsv
  [[ -f $f ]] || f=${XDG_STATE_HOME:-$HOME/.local/state}/rhce-verify/history.tsv
  [[ -f $f ]] || { echo "No run history yet on this machine."; return 0; }
  echo "${B}when              lab        host      pass fail check  verdict${Z}"
  awk -F'\t' '{ printf "%-17s %-10s %-9s %4s %4s %5s  %s\n", $1, $2, $3, $4, $5, $6, $7 }' "$f" | tail -40
}

run_one() {
  local name="$1"; shift
  local s
  s=$(script_for "$name") || { echo "${R}Unknown lab: $name${Z}" >&2; return 2; }
  [[ -f $s ]] || { echo "${R}Missing script: $s${Z}" >&2; return 2; }
  bash "$s" "$@"
}

# ------------------------------------------------------------------------------
case "${1:-}" in
  ""|-h|--help|help|list) usage; exit 0 ;;
  bundle)  do_bundle; exit 0 ;;
  history) do_history; exit 0 ;;
esac

name=$1; shift

if [[ -n ${LAB_GROUPS[$name]:-} ]]; then
  fails=0 total=0
  for l in ${LAB_GROUPS[$name]}; do
    total=$((total + 1))
    echo
    run_one "$l" "$@" || fails=$((fails + 1))
  done
  echo
  echo "${B}Group '$name': $((total - fails)) of $total lab(s) fully passed.${Z}"
  ((fails == 0)) || exit 1
  exit 0
fi

run_one "$name" "$@"
